# Supabase project URL and public anon key are used by auth verification.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
# Server-only key with elevated database and Storage access.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Exact storefront origin; HTTPS origin in production, no path.
FRONTEND_URL=http://localhost:8080
PORT=5000
# Non-Render deployments: set the exact trusted reverse proxy hop count; do not use `true`.
# Render web services automatically trust their single app-facing load balancer hop.
TRUST_PROXY_HOPS=0

# OTP hashes must use a random secret of at least 32 characters.
OTP_HASH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Resend is the configured backend email provider. Verify the sender domain in Resend.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Bhasi Gift Studio <no-reply@example.com>

# Optional. Required only when AI design and photo transform are enabled.
OPENAI_API_KEY=

# Razorpay TEST mode credentials. Never expose these in frontend environment variables.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_LIVE_ENABLED=false

# Optional manual UPI QR checkout. Both values are required to show this option.
# Host the merchant QR image at a public HTTPS URL; use the exact merchant UPI ID.
UPI_QR_IMAGE_URL=
MERCHANT_UPI_ID=
